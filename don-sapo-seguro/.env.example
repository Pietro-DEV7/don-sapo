# Neon PostgreSQL — use a connection string com SSL (Neon fornece sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Gere com: openssl rand -base64 32 (32 bytes)
APP_ENCRYPTION_KEY=COLOQUE_UMA_CHAVE_BASE64_DE_32_BYTES
# URL pública exata do site, sem barra no final
APP_ORIGIN=https://seu-dominio.com
# Porta local / plataforma
PORT=3000
NODE_ENV=production
